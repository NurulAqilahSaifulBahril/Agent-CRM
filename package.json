{
  "name": "agent-crm",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.js",
    "start": "node scripts/start.js",
    "lint": "eslint",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4"
  },
  "description": "Lead-tracking CRM for solar sales agents",
  "author": "Eternalgy",
  "main": "electron/main.js",
  "build": {
    "appId": "com.eternalgy.agentcrm",
    "productName": "Agent CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!data/**",
          "!**/.env*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Agent-CRM-Setup-${version}.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "NurulAqilahSaifulBahril",
        "repo": "Agent-CRM"
      }
    ]
  },
  "productName": "Agent CRM"
}
